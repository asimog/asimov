{
  "name": "asimog",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "agent-browser",
      "bigint-buffer",
      "bufferutil",
      "utf-8-validate",
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "tsx services/core/src/main.ts",
    "ctl": "tsx services/core/src/cli/ctl.ts",
    "pg:start": "docker compose --env-file .env.local up -d pg",
    "pg:stop": "docker stop asimog-pg",
    "stack:data": "docker compose --env-file .env.local up -d pg neo4j",
    "stack:up": "docker compose --env-file .env.local --profile workers up -d --build",
    "stack:down": "docker compose --env-file .env.local --profile workers stop",
    "e2e": "tsx tests/e2e/run.ts",
    "relay": "tsx services/relay/src/main.ts",
    "web": "pnpm --filter @asimog/web dev",
    "lint": "biome check .",
    "typecheck": "tsc -p services/core --noEmit",
    "agents": "tsx services/agents/src/main.ts",
    "agents:smoke": "tsx services/agents/src/smoke.ts",
    "bettafish": "cd services/bettafish/engine && .venv-asimog/Scripts/python asimog_worker.py",
    "miroshark": "cd services/miroshark/engine/backend && .venv-asimog/Scripts/python asimog_worker.py",
    "slow-bridge": "tsx services/slow-bridge/src/main.ts"
  },
  "type": "module"
}
