{
  "name": "asimog",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "agent-browser",
      "bigint-buffer",
      "bufferutil",
      "utf-8-validate",
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "tsx services/core/src/main.ts",
    "ctl": "tsx services/core/src/cli/ctl.ts",
    "pg:start": "docker start asimog-pg || docker run -d --name asimog-pg --restart unless-stopped -e POSTGRES_USER=asimog -e POSTGRES_DB=asimog -e POSTGRES_HOST_AUTH_METHOD=trust -p 127.0.0.1:54329:5432 -v asimog-pg:/var/lib/postgresql postgres:18 -c synchronous_commit=off",
    "pg:stop": "docker stop asimog-pg",
    "e2e": "tsx tests/e2e/run.ts",
    "relay": "tsx services/relay/src/main.ts",
    "web": "pnpm --filter @asimog/web dev",
    "lint": "biome check .",
    "typecheck": "tsc -p services/core --noEmit"
  },
  "type": "module"
}
