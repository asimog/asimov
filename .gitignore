# Upstream prior-art code: read-only, never committed, never imported. See .upstream/UPSTREAM.md
/.upstream/

# Secrets
.env
.env.*
!.env.example
*.keypair.json
agent-browser-state/

# Dependencies and builds
node_modules/
.pnpm-store/
.venv/
__pycache__/
.next/
dist/
build/

# Runtime data (tapes live in object storage; small fixture tapes live in tests/e2e/fixtures)
data/
artifacts/
*.har

# Owner's raw reference videos (GIFs and sheets live in docs/inspiration)
uxinsipirevideos/
*:Zone.Identifier
.impeccable/

# asimog: local Python envs for the vendored engines
.venv-asimog/
*.tsbuildinfo

# Audits and fix plans: they name attack paths in unfixed code, and the repo is public
docs/audits/

# Local tool state and OS files
.claude/settings.local.json
*.log
Thumbs.db
desktop.ini
.DS_Store
