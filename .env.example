# Copy to .env.local and fill in. Never commit real values.
# --- providers (docs/OPS.md) ---
HELIUS_API_KEY=
RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# Free providers, tried in this order: name|requests per second|url. The URLs come from .env.local (keys live there);
# an entry whose URL is empty is dropped. Per provider NAME (upper case): RPC_DENY_NAME methods its plan refuses,
# RPC_BUDGET_NAME monthly units (unset = no cap, 0 = zero), RPC_COST_NAME units per call. Limits read from each provider's docs, 2026-10-17 (docs/OPS.md).
RPC_URLS=helius|10|${RPC_URL},chainstack|5|${CHAINSTACK_URL},rpcfast|15|${RPCFAST_URL},fluxrpc|15|${FLUXRPC_URL},quicknode|15|${QUICKNODE_URL}
RPC_BUDGET_HELIUS=1000000
RPC_BUDGET_CHAINSTACK=3000000
RPC_BUDGET_RPCFAST=1500000
RPC_BUDGET_QUICKNODE=10000000
RPC_COST_QUICKNODE=30
RPC_DENY_CHAINSTACK=getProgramAccounts,getTokenLargestAccounts
RPC_DENY_RPCFAST=getProgramAccounts,getTokenAccountsByOwner,getTokenAccountsByDelegate,getTokenLargestAccounts
RPC_BUDGET_STOP=0.95
# RugCheck risk reports (key and URL in .env.local); requests per second is our own guess, the docs state none
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_CHEAP=deepseek/deepseek-v4.1-flash
LLM_MODEL_SMART=deepseek/deepseek-v4.1-flash
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
# --- pump.fun realtime (public web-client subscriber credentials, docs/research/pumpfun-endpoints.md) ---
PUMP_NATS_USER=subscriber
PUMP_NATS_PASS=
PUMP_NATS_FEED_PASS=
PUMP_NATS_TRADES_URL=wss://unified-prod.nats.realtime.pump.fun
PUMP_NATS_FEED_URL=wss://prod-v2.nats.realtime.pump.fun
# --- runtime ---
ASIMOG_MODE=paper
DATABASE_URL=postgres://asimog@127.0.0.1:54329/asimog
CORE_PORT=7400
RELAY_PORT=7401
# --- scale knobs: sized for a small VM by default ---
SESSIONS=3
FEED_POLL_MS=3000
WATCH_MAX_COINS=60
JEV_TOKENS_PER_HOUR=1500000
JEV_CONCURRENCY=4
TAPE_BATCH_MS=100
TAPE_MAX_QUEUED=200000
# a clock.tick on the Tape this often: time exits and sweeps run in a quiet period, and a replay sees the same ticks
TAPE_TICK_MS=5000
JEV_QUEUE_MAX=64
JEV_MAX_AGE_S=60
DB_POOL=8
# --- compressed horizons (docs/PIPELINE.md, docs/STRATEGY.md): minutes, not hours ---
WAVE_N=3
WAVE_HORIZON_MIN=5
ECHO_WINDOW_MIN=10
OUTCOME_HORIZONS_MIN=1,3,5
HORIZON_FAST_MIN=3
HORIZON_MEDIUM_MIN=10
HORIZON_SLOW_MIN=30
ENTRY_WINDOW_MIN=10
ALLOCATE_EVERY_S=120
EVOLVE_EVERY_S=120
RETIRE_IDLE_MIN=120
# --- paper desk (docs/STRATEGY.md) ---
GHOST_BOOK_SOL=0.2
POOL_MAX=128
FILL_LATENCY_MEDIAN_MS=1500
FILL_FAIL_P=0.05
PRIORITY_FEE_SOL=0.00005
ATA_RENT_SOL=0.00203928
# --- Index (docs/PIPELINE.md): a 30-day window with a 7-day half-life (fix plan 2.2; the 1-day slice of 2026-10-17 is retired) ---
INDEX_WINDOW_DAYS=30
INDEX_CALLOUT_DAYS=30
INDEX_HALF_LIFE_DAYS=7
INDEX_SEED_HOURS=24
# --- slow mind (docs/OPS.md, docs/SYSTEM.md): one key per lane in .env.local; LLM_STUB=1 runs everything offline ---
LLM_STUB=0
# embeddings for the agent runtime (docs/OPS.md): OpenRouter embedding models through the OpenAI-compatible API.
# Set EMBEDDING_MODEL to an OpenRouter embedding model id and EMBEDDING_API_KEY in .env.local. MiroShark graph memory reads these too.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=${LLM_BASE_URL}
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# E3: wiki pages for callers measured at least this often, at most this many caller pages
WIKI_MIN_CALLS=5
WIKI_MAX_CALLERS=50
# E5: the Librarian's embedding spend, metered like a lane (agents.spend, lane EMBED)
LLM_USD_HOUR_EMBED=0.05
# E7b: a scraped reply at least this similar to an example in config/rug-exemplars.json counts as a rug report
RUG_SIMILARITY=0.8
# E7: callouts at least this similar join one narrative cluster; clusters cover this many hours and are built this often
NARRATIVE_SIMILARITY=0.85
NARRATIVE_WINDOW_H=24
NARRATIVE_EVERY_MIN=60
EMBEDDING_PRICE_PER_M=0.02
LLM_USD_HOUR_SYNTH=0.2
LLM_USD_HOUR_SWARM=0.5
LLM_USD_HOUR_EXTRACT=0.1
LLM_USD_HOUR_THINK=0.2
LLM_USD_HOUR_OPS=0.1
LLM_PRICE_IN_PER_M=0.032
LLM_PRICE_OUT_PER_M=0.144
MCP_PORT=7403
MCP_URL=http://127.0.0.1:${MCP_PORT}/mcp
BETTAFISH_PRESET=lite
SWARM_PRESET=lite

# Signer and treasury (docs/EXECUTION.md, 10, 15). Keys and tokens live in .env.local only; the Signer reads keypair FILES the owner places.
SIGNER_HOST=127.0.0.1
SIGNER_PORT=7410
SIGNER_MAX_ORDER_SOL=0.05
SIGNER_MAX_PRIORITY_LAMPORTS=200000
SIGNER_RATE_PER_MIN=30
FUN_BLOCK_URL=https://fun-block.pump.fun
SWEEP_EVERY_MIN=10
RECONCILE_EVERY_MIN=60
KILL_SIGNER_REFUSALS=3
KILL_REFUSAL_WINDOW_MIN=10
KILL_FEED_GAP_MIN=5
# owner sets (empty here): SIGNER_KEYPAIR_TRADE/CREATOR/AGENT (file paths), SIGNER_TOKENS, SIGNER_CLIENT_TOKEN_SWAP/TREASURY,
# SIGNER_FEE_RECIPIENTS, WALLET_TRADE/CREATOR/AGENT/OPERATOR (public keys), COIN_MINT, TX_SEND_URL, ADMIN_TOKEN, LIVE_STRATEGIES, AGENT_RUNWAY_SOL
NEXT_PUBLIC_EXPLORER_TX_URL=
POSTMORTEM_MISSED_MULT=2
# --- slow mind (docs/SLOW-MIND.md): BettaFish and MiroShark engines in services/*/engine, Slow Bridge, stack in docker-compose.yml ---
SLOW_BRIDGE_PORT=7404
BETTAFISH_PORT=7412
MIROSHARK_PORT=7411
BETTAFISH_URL=http://127.0.0.1:${BETTAFISH_PORT}
MIROSHARK_URL=http://127.0.0.1:${MIROSHARK_PORT}
BETTAFISH_DB_URL=postgresql://slow_reader@127.0.0.1:54329/asimog
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_HEAP=512m
# lane keys (one OpenRouter key per lane, each with its own spend limit; values in .env.local)
LLM_KEY_SYNTH=
LLM_KEY_SWARM=
# free fallback chain in config/models.json (E4): a separate OpenRouter key used only when a primary model fails
LLM_FALLBACK_KEY=
# BettaFish engines: every base URL and model from our env (ASIMOG_FORK=1 refuses defaults)
INSIGHT_ENGINE_API_KEY=${LLM_KEY_SYNTH}
INSIGHT_ENGINE_BASE_URL=${LLM_BASE_URL}
INSIGHT_ENGINE_MODEL_NAME=${LLM_MODEL_CHEAP}
QUERY_ENGINE_API_KEY=${LLM_KEY_SYNTH}
QUERY_ENGINE_BASE_URL=${LLM_BASE_URL}
QUERY_ENGINE_MODEL_NAME=${LLM_MODEL_CHEAP}
MEDIA_ENGINE_API_KEY=${LLM_KEY_SYNTH}
MEDIA_ENGINE_BASE_URL=${LLM_BASE_URL}
MEDIA_ENGINE_MODEL_NAME=${LLM_MODEL_CHEAP}
REPORT_ENGINE_API_KEY=${LLM_KEY_SYNTH}
REPORT_ENGINE_BASE_URL=${LLM_BASE_URL}
REPORT_ENGINE_MODEL_NAME=${LLM_MODEL_CHEAP}
FORUM_HOST_API_KEY=${LLM_KEY_SYNTH}
FORUM_HOST_BASE_URL=${LLM_BASE_URL}
FORUM_HOST_MODEL_NAME=${LLM_MODEL_SMART}
KEYWORD_OPTIMIZER_API_KEY=${LLM_KEY_SYNTH}
KEYWORD_OPTIMIZER_BASE_URL=${LLM_BASE_URL}
KEYWORD_OPTIMIZER_MODEL_NAME=${LLM_MODEL_CHEAP}
SEARCH_TOOL_TYPE=AsimogMedia
QUERY_SEARCH=tavily,x
TAVILY_API_KEY=
X_BEARER_TOKEN=
MAX_PARAGRAPHS=4
MAX_REFLECTIONS=1
# MiroShark engine
LLM_PROVIDER=openai
LLM_API_KEY=${LLM_KEY_SWARM}
LLM_MODEL_NAME=${LLM_MODEL_CHEAP}
SMART_MODEL_NAME=${LLM_MODEL_CHEAP}
WONDERWALL_MODEL_NAME=${LLM_MODEL_CHEAP}
NER_MODEL_NAME=${LLM_MODEL_CHEAP}
WEB_SEARCH_MODEL=
SWARM_PLATFORMS=pumpfun,twitter
SWARM_TWITTER_RECSYS=random
# graph memory: off (in memory), minimal (Neo4j, no embeddings), all (Neo4j, every upstream feature, needs EMBEDDING_*)
SWARM_GRAPH_FEATURES=minimal
# the swarm report: agent (upstream ReportAgent, SMART_MODEL_NAME) or numbers (code-written sections only)
SWARM_REPORT=agent
# caller personas and the report agent read the core MCP with the read-only cap:swarm.read token (MCP_TOKENS in .env.local)
CORE_MCP_URL=${MCP_URL}
SWARM_CORE_TOKEN=
MCP_AGENT_TOOLS_ENABLED=true
SWARM_PERSONA_TOOLS=coin_dossier,reports_for
# Reply Reader and media cache (docs/SLOW-MIND.md 4.2)
SENSE_REPLIES=true
REPLY_POLL_S=60
REPLY_WINDOW_H=6
REPLY_CALLOUTS_PER_MIN=20
SENSE_MEDIA=true
MEDIA_PER_MIN=30
MEDIA_MAX_BYTES=2000000
MEDIA_HOSTS=socialimages.pump.fun,pump.mypinata.cloud,ipfs.io
MEDIA_IPFS_GATEWAY=https://pump.mypinata.cloud
# pump.fun read API (docs/research/pumpfun-endpoints.md)
PUMP_API_URL=https://frontend-api-v3.pump.fun
# Slow Bridge (docs/SLOW-MIND.md section 5): MCP tokens come from MCP_TOKENS in .env.local ("cap=token,..."); one per capability
MCP_TOKEN_SYNTH=
MCP_TOKEN_SWARM=
MCP_TOKEN_EXCHANGE=
# thinking agents (services/agents/src/lanes.ts tokenEnv): each value must also appear in MCP_TOKENS as cap=token
MCP_TOKEN_OPS=
MCP_TOKEN_POSTMORTEM=
MCP_TOKEN_RESEARCHER=
MCP_TOKEN_REPORTER=
MCP_TOKEN_INTEGRITY=
MCP_TOKEN_LIBRARIAN=
MCP_TOKEN_WIKI=
BETTAFISH_FEED_EVERY_MIN=30
BETTAFISH_FEED_WINDOW_MIN=60
BETTAFISH_COIN_RUNS_PER_HOUR=6
SLOW_CHAIN=parallel
SLOW_CHAIN_WAIT_S=300
SLOW_RUN_TIMEOUT_S=1800
# BettaFish worker: one deadline for a whole run, below the Bridge timeout, so a hung engine frees its slot
BETTAFISH_RUN_DEADLINE_S=1500
SLOW_POLL_MS=3000
SLOW_TICK_S=30
SLOW_SCHEDULE_S=5
SLOW_DEFER_MAX_MIN=90
# each worker refuses a request without its bearer token (set both in .env.local); at most this many runs at once
BETTAFISH_WORKER_TOKEN=
SWARM_WORKER_TOKEN=
BETTAFISH_MAX_CONCURRENT=2
SWARM_MAX_CONCURRENT=1
SWARM_RUNS_PER_HOUR=6
# escalation gate and spend caps (docs/SLOW-MIND.md section 3; owner, docs/DECISIONS.md 2026-10-19: low test limits while D is built)
SLOW_STAGE1_USD_PER_RUN=0.005
SLOW_STAGE2_USD_PER_RUN=0.03
SLOW_STAGE3_USD_PER_RUN=0.10
SLOW_USD_PER_DAY=0.50
ESC_P_LOW=0.35
ESC_P_HIGH=0.65
ESC_DISAGREE=0.3
HOT_SET_SIZE=5
HOT_SET_EVERY_S=90
# the gate grants a coin at most once per ESC_RECHECK_MIN (the hot set too); a callout keeps a coin in play ESC_CALLOUT_S
ESC_RECHECK_MIN=10
ESC_CALLOUT_S=60
# minutes of callouts a coin run reads (the feed run reads BETTAFISH_FEED_WINDOW_MIN)
SLOW_COIN_WINDOW_MIN=10
# the SOL price the gate uses to turn a stage's USD cost into SOL (owner sets it; no price feed)
SOL_USD=150
BETTAFISH_SENTIMENT=on
SWARM_HORIZON_MIN=120
SWARM_WAVE_CALLERS=5
STANCE_HORIZON_MIN=60

# --- defaults that lived in code until fix plan 2.1; each key has one default, here ---
CALLERS_ACTIVE_MAX=200
DNA_HORIZON_MIN=5
HAWKES_ALPHA=0.6
HAWKES_BETA_PER_MIN=0.3333333333
HAWKES_MC_PATHS=300
HAWKES_MU_PER_MIN=0.01
CURVE_REAL_TOK0=793100000
CURVE_V_SOL0=30
CURVE_V_TOK0=1073000000
FEE_BPS=125
SMART_WINDOW_MIN=5
PRECALL_HORIZON_MIN=5
PRECALL_PEAK_MULT=1.2
PRECALL_PRIOR_N=4
TX_RPC_TIMEOUT_MS=10000
TRADER_CONFIRM_MS=30000
TRADER_GIVE_UP_MS=120000
TRADER_HEADROOM_LAMPORTS=100000
TRADER_RENT_ALLOWANCE_LAMPORTS=2100000
TRADER_RETRY_BASE_MS=2000
TRADER_SELL_ATTEMPTS=5
INDEX_MIN_AGE_MIN=30
INDEX_MIN_COINS=8
INDEX_MIN_COINS_SEED=3
INDEX_ROUND_TRIP_COST=0.03
INDEX_SMART_MAX=500
INDEX_SNIPER_SHARE=0.5
# C9 archetypes: a copier buys a coin within INDEX_COPY_LAG_S after a smart wallet on at least INDEX_COPIER_SHARE of its coins;
# a bundler shares a funder with another early buyer of the same coin on at least INDEX_BUNDLER_COINS coins
INDEX_COPY_LAG_S=30
INDEX_COPIER_SHARE=0.5
INDEX_BUNDLER_COINS=2
# C9 creator records: a past coin is at least CREATOR_PAST_MIN old; one that did not graduate and fell under CREATOR_RUG_FRAC of its peak is a rug
CREATOR_PAST_MIN=60
CREATOR_RUG_FRAC=0.3
# C9 funder links: early buyers looked up per Index run (two RPC calls each)
FUNDER_LOOKUPS_PER_RUN=50
BUNDLE_SLOTS=3
INDEX_COIN_IDLE_MIN=30
# most coins the rollup holds in memory (each keeps a map per wallet); the least recently active leave early once written
INDEX_MAX_COINS=3000
RPC_MAX_TRIES=6
RPC_RPS=5
RPC_TIMEOUT_MS=8000
DOCTOR_CONSUMER_LAG_S=300
DOCTOR_HEAD_STALL_S=120
W_COMMENT=2
W_LIKE=1
W_SHARE=3
EVAL_MIN_MS=5000
REENTRY_COOLDOWN_S=60
SWEEP_MS=5000
EVOLVE_MIN_DISTANCE=0.05
EVOLVE_NICHE_MAX=12
EVOLVE_OFFSPRING=16
EVOLVE_PARENT_MIN_TRADES=2
RETIRE_DD_FRAC=0.3
RETIRE_MIN_TRADES=50
AMM_FEE_BPS=125
FILL_LATENCY_SIGMA=0.5
FILL_STALE_MS=30000
KERNEL_CAP_FULL=0.25
KERNEL_CAP_PROBE=0.05
KERNEL_HURDLE=0
KERNEL_PRIOR_MEAN=-0.01
KERNEL_PRIOR_N=5
KERNEL_PRIOR_SD=0.25
# calibration (C3, owner 2026-10-19): decisions per bin of a family's map, and the cap on the Kelly fraction once a map has 3 bins
CALIB_MIN_PER_BIN=20
KELLY_CAP=0.25
# a score term whose signal confidence is under this counts as missing (docs/STRATEGY.md section 4)
TERM_MIN_CONF=0.3
PROMOTE_FULL_EXTRA_TRADES=20
# the latest share of a family's per-coin results held out: the family must clear its raised bound there before any member leaves ghost (C4)
PROMOTE_HOLDOUT_FRAC=0.3
PROMOTE_MAX_DD_FRAC=0.3
PROMOTE_MIN_TRADES=30
JEV_CALLOUT_MIN_FOLLOWERS=0
JEV_TIMEOUT_MS=4000
HOLDERS_DELAY_S=15
# pages of 1000 curve signatures read back to the creation transaction; a busier curve leaves the launch facts unknown
LAUNCH_SIG_PAGES=5
INDEX_REFRESH_MIN=60
SCOUT=true
SENSE_BACKFILL=true
SENSE_CHAIN=true
SENSE_FEED=true
ARCHIVER=true
# archive targets (B6b): the endpoint and keys are secrets; config names the bucket, region and prefix
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STATS_EVERY_MS=30000
ENTRY_STALE_S=60
OUTCOME_GRACE_S=60
OUTCOME_REF_SOL=0.02
SCORE_EVERY_S=60
# Brier scores sum this many trailing days (one bucket per day); older days leave the window
SCORE_WINDOW_DAYS=30
RPC_BACKFILL_SIGS=200
RPC_BACKFILL_TX_PER_HOUR=3000
WATCH_HOURS=6
FEED_BACKFILL_MIN=30
FEED_BACKFILL_PAGES=40
FEED_GAP_PAGES=10
FEED_PAGE_SIZE=50
FEED_PUSH=true
# Share of callouts the door refused that are written as filter.sampled, by a hash of the callout id (B2).
FILTER_SAMPLE_PCT=1
INDEX_CALLOUT_PAGES=30000
INDEX_CALLOUT_PAGE_MS=2000
SCOUT_CALLERS_REFRESH_S=60
SCOUT_HEAT_BUYERS=8
SCOUT_HEAT_NET_SOL=1.5
SCOUT_MIN_BUYERS=10
SCOUT_MIN_MCAP_USD=4000
# Most wallets the Scout keeps in memory (callers, smart wallets and wallets checked and found plain). The rest live in idx.scout_wallet and are looked up on a miss.
SCOUT_HOT_WALLETS=5000
KILL_FILL_DRIFT_FILLS=3
KILL_FILL_DRIFT_WINDOW_MIN=60
KILL_FILL_DRIFT_X=3
PROOF_MEMO=true
SWEEP_FEE_RESERVE_LAMPORTS=20000
AGENT_RUNWAY_SOL=0
TRADER_RETRY_EVERY_MS=2000
MANDATE_SOL=0.2
RELAY_DB_POOL=3
RELAY_POLL_MS=400
