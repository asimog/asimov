# Copy to .env.local and fill in. Never commit real values.
# --- providers (docs/15) ---
HELIUS_API_KEY=
RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_CHEAP=deepseek/deepseek-v4.1-flash
LLM_MODEL_SMART=deepseek/deepseek-v4.1-flash
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
# --- pump.fun realtime (public web-client subscriber credentials, docs/research/pumpfun-endpoints.md) ---
PUMP_NATS_USER=subscriber
PUMP_NATS_PASS=
PUMP_NATS_FEED_PASS=
PUMP_NATS_TRADES_URL=wss://unified-prod.nats.realtime.pump.fun
PUMP_NATS_FEED_URL=wss://prod-v2.nats.realtime.pump.fun
# --- runtime ---
ASIMOG_MODE=paper
DATABASE_URL=postgres://asimog@127.0.0.1:54329/asimog
CORE_PORT=7400
RELAY_PORT=7401
# --- scale knobs: sized for a small VM by default ---
SESSIONS=3
FEED_POLL_MS=3000
WATCH_MAX_COINS=60
JEV_TOKENS_PER_HOUR=1500000
JEV_CONCURRENCY=4
LLM_USD_PER_HOUR=0.5
TAPE_BATCH_MS=100
JEV_QUEUE_MAX=64
JEV_MAX_AGE_S=60
DB_POOL=8
# --- compressed horizons (docs/07, docs/08): minutes, not hours ---
WAVE_N=3
WAVE_HORIZON_MIN=5
ECHO_WINDOW_MIN=10
OUTCOME_HORIZONS_MIN=1,3,5
HORIZON_FAST_MIN=3
HORIZON_MEDIUM_MIN=10
HORIZON_SLOW_MIN=30
ENTRY_WINDOW_MIN=10
ALLOCATE_EVERY_S=120
EVOLVE_EVERY_S=120
RETIRE_IDLE_MIN=120
# --- paper desk (docs/08) ---
GHOST_BOOK_SOL=0.2
POOL_MAX=128
FILL_LATENCY_MEDIAN_MS=1500
FILL_FAIL_P=0.05
PRIORITY_FEE_SOL=0.00005
ATA_RENT_SOL=0.00148844
